{
  "name": "codex-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-e2e.mjs --grep @smoke",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:pwa": "npm run build && node scripts/run-e2e.mjs --config playwright.pwa.config.ts",
    "lint": "biome lint --error-on-warnings src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "quiz:check": "vitest run src/quizValidation.test.ts",
    "docs:check": "node scripts/validate-doc-links.mjs",
    "content:queue": "node scripts/content-inventory.mjs --priority",
    "content:links": "node scripts/check-content-links.mjs",
    "content:sources": "node scripts/check-source-diff.mjs",
    "content:overlap": "node scripts/content-overlap.mjs",
    "content:distractors": "node scripts/content-distractors.mjs",
    "content:tools:check": "node --check scripts/check-content-links.mjs && node --check scripts/content-overlap.mjs && node --check scripts/content-distractors.mjs && node --check scripts/check-source-diff.mjs && node --test scripts/source-audit-core.test.mjs",
    "pwa:check": "node scripts/validate-pwa.mjs && node scripts/validate-service-worker.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lighthouse:check": "node scripts/check-lighthouse.mjs",
    "type-coverage": "type-coverage --at-least 95 --strict",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run content:tools:check && npm run test && npm run docs:check && npm run pwa:check && npm run type-coverage && npm run build && npm run bundle:check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.5.0",
    "type-coverage": "^2.29.7",
    "vitest": "^4.1.8"
  }
}
